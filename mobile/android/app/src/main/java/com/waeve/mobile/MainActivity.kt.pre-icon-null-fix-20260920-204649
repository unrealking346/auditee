private fun startTrack(t: Track, controller: MediaController?, queue: List<Track>, set: (Track) -> Unit) {
    set(t)
    val playable = queue.filter { !it.audioUrl.isNullOrBlank() }
    if (controller != null && playable.isNotEmpty()) {
        val items = playable.map { MediaItem.Builder().setUri(it.audioUrl!!).setMediaId(it.id).build() }
        val index = playable.indexOfFirst { it.id == t.id }.coerceAtLeast(0)
        controller.setMediaItems(items, index, 0L)
        controller.prepare()
        controller.play()
    }
}
private fun enqueueAndPlay(t: Track, controller: MediaController?, old: List<Track>, done: (Pair<List<Track>, Track>) -> Unit) { val q = (old + t).distinctBy { it.id }; startTrack(t, controller, q, { done(q to it) }) }
private fun nextTrack(controller: MediaController?, q: List<Track>, current: Track?, shuffle: Boolean): Track? { if (q.isEmpty()) return null; if (shuffle) return q.filter { it.id != current?.id }.randomOrNull() ?: q.first(); val i = q.indexOfFirst { it.id == current?.id }; return q.getOrNull(i + 1) ?: q.first() }
