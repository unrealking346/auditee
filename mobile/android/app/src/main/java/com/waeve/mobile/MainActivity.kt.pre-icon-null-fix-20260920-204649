data class Track(val id: String, val title: String, val artist: String, val artwork: String? = null, val audioUrl: String? = null, val release: String? = null)
data class Artist(val id: String, val name: String, val followers: Int = 0, val verified: Boolean = false)
data class Playlist(val id: String, val name: String, val songs: Int = 0, val collaborative: Boolean = false)
data class HomeData(val recent: List<Track> = emptyList(), val made: List<Track> = emptyList(), val releases: List<Track> = emptyList(), val rising: List<Artist> = emptyList())

class WaeveApi(context: Context) {
    private val prefs = context.getSharedPreferences("waeve", Context.MODE_PRIVATE)
    private val executor = Executors.newCachedThreadPool()
    var token: String?
        get() = prefs.getString("token", null)
        private set(value) { prefs.edit().putString("token", value).apply() }
    private val base get() = BuildConfig.WAEVE_API_BASE_URL.trimEnd('/')

    fun clearSession() { prefs.edit().remove("token").remove("user").apply(); token = null }

    fun request(path: String, method: String = "GET", body: String? = null, done: (Result<String>) -> Unit) {
        executor.execute {
            try {
                val c = URL(base + path).openConnection() as HttpURLConnection
                c.requestMethod = method
                c.connectTimeout = 12000
                c.readTimeout = 20000
                c.setRequestProperty("Accept", "application/json")
                c.setRequestProperty("Content-Type", "application/json")
                token?.let { c.setRequestProperty("Authorization", "Bearer $it") }
                if (body != null) { c.doOutput = true; c.outputStream.use { it.write(body.toByteArray()) } }
                val code = c.responseCode
                val stream = if (code in 200..399) c.inputStream else c.errorStream
                val text = stream?.let { BufferedReader(InputStreamReader(it)).use { r -> r.readText() } } ?: ""
                if (code in 200..299) done(Result.success(text)) else done(Result.failure(IllegalStateException(error(text) ?: "WAEVE request failed ($code)")))
                c.disconnect()
            } catch (t: Throwable) { done(Result.failure(t)) }
        }
    }

    fun login(email: String, password: String, done: (Result<String>) -> Unit) = request("/auth/login", "POST", JSONObject().put("email", email).put("password", password).toString()) { r -> r.onSuccess { token = JSONObject(it).optString("accessToken", "").ifBlank { null }; done(Result.success(it)) }.onFailure { done(Result.failure(it)) } }
    fun register(email: String, password: String, username: String, name: String, country: String, done: (Result<String>) -> Unit) {
        val body = JSONObject().put("email", email).put("password", password).put("username", username).put("displayName", name).put("country", country)
        request("/auth/register", "POST", body.toString()) { r -> r.onSuccess { token = JSONObject(it).optString("accessToken", "").ifBlank { null }; done(Result.success(it)) }.onFailure { done(Result.failure(it)) } }
    }
    fun loadHome(done: (Result<HomeData>) -> Unit) = request("/home") { r -> r.onSuccess { done(Result.success(parseHome(it))) }.onFailure { done(Result.failure(it)) } }
    fun search(q: String, done: (Result<HomeData>) -> Unit) = request("/search?q=" + URLEncoder.encode(q, "UTF-8")) { r -> r.onSuccess { val o = JSONObject(it); done(Result.success(HomeData(releases = parseTracks(o.optJSONArray("tracks")), rising = parseArtists(o.optJSONArray("artists"))))) }.onFailure { done(Result.failure(it)) } }
    fun playlists(done: (Result<List<Playlist>>) -> Unit) = request("/playlists") { r -> r.onSuccess { val a = JSONObject(it).optJSONArray("playlists"); done(Result.success(parsePlaylists(a))) }.onFailure { done(Result.failure(it)) } }
    fun createPlaylist(name: String, collaborative: Boolean, done: (Result<String>) -> Unit) = request("/playlists", "POST", JSONObject().put("name", name).put("collaborative", collaborative).put("visibility", "PRIVATE").toString(), done)
    fun like(id: String, done: (Result<String>) -> Unit) = request("/tracks/$id/like", "POST", null, done)
    fun followArtist(id: String, done: (Result<String>) -> Unit) = request("/artists/$id/follow", "POST", null, done)
    fun playback(id: String, ms: Long, completed: Boolean, done: (Result<String>) -> Unit = {}) = request("/playback/events", "POST", JSONObject().put("trackId", id).put("playedMs", ms).put("completed", completed).toString(), done)

    private fun error(raw: String) = try { JSONObject(raw).optJSONObject("error")?.optString("message") } catch (_: Throwable) { null }
    private fun parseHome(raw: String): HomeData { val o = JSONObject(raw); return HomeData(parseTracks(o.optJSONArray("recentlyPlayed")), parseTracks(o.optJSONArray("madeForYou")), parseTracks(o.optJSONArray("newReleases")), parseArtists(o.optJSONArray("risingArtists"))) }
    private fun parseTracks(a: JSONArray?): List<Track> = if (a == null) emptyList() else (0 until a.length()).mapNotNull { i -> a.optJSONObject(i)?.let { o -> val rel = o.optJSONObject("release"); Track(o.optString("id"), o.optString("title"), o.optString("artistName", rel?.optJSONObject("artist")?.optString("stageName") ?: "WAEVE"), o.optString("artworkUrl", "").ifBlank { null } ?: rel?.optString("coverUrl", "").ifBlank { null }, o.optString("audioUrl", null), rel?.optString("title")) } }
    private fun parseArtists(a: JSONArray?): List<Artist> = if (a == null) emptyList() else (0 until a.length()).mapNotNull { i -> a.optJSONObject(i)?.let { Artist(it.optString("id"), it.optString("stageName"), it.optInt("followersCount"), it.optBoolean("verified")) } }
    private fun parsePlaylists(a: JSONArray?): List<Playlist> = if (a == null) emptyList() else (0 until a.length()).mapNotNull { i -> a.optJSONObject(i)?.let { Playlist(it.optString("id"), it.optString("name"), it.optJSONArray("tracks")?.length() ?: 0, it.optBoolean("collaborative")) } }
}

class MainActivity : ComponentActivity() {
    private lateinit var api: WaeveApi
    private var controllerFuture: ListenableFuture<MediaController>? = null
    private var controller: MediaController? = null
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState); enableEdgeToEdge(); api = WaeveApi(this)
        val token = SessionToken(this, ComponentName(this, WaevePlaybackService::class.java))
        controllerFuture = MediaController.Builder(this, token).buildAsync().also { f -> f.addListener({ runCatching { controller = f.get() } }, ContextCompat.getMainExecutor(this)) }
        setContent { WaeveApp(api) { controller } }
    }
    override fun onDestroy() { controller?.release(); controllerFuture?.cancel(false); super.onDestroy() }
}

@Composable
fun WaeveApp(api: WaeveApi, controllerProvider: () -> MediaController?) {
    var session by rememberSaveable { mutableStateOf("splash") }
    var tab by rememberSaveable { mutableStateOf("home") }
    var route by rememberSaveable { mutableStateOf("main") }
    var current by remember { mutableStateOf<Track?>(null) }
    var queue by remember { mutableStateOf<List<Track>>(emptyList()) }
    var playing by remember { mutableStateOf(false) }
    var position by remember { mutableLongStateOf(0L) }
    var duration by remember { mutableLongStateOf(0L) }
    var shuffle by rememberSaveable { mutableStateOf(false) }
    var repeat by rememberSaveable { mutableStateOf(0) }
    var showCreate by remember { mutableStateOf(false) }
    var toast by remember { mutableStateOf<String?>(null) }
    val snackbar = remember { SnackbarHostState() }
    val scope = rememberCoroutineScope()
    LaunchedEffect(toast) { toast?.let { snackbar.showSnackbar(it); toast = null } }
    val controller = controllerProvider()
    LaunchedEffect(controller) { while (true) { controller?.let { position = it.currentPosition.coerceAtLeast(0); duration = it.duration.coerceAtLeast(0); playing = it.isPlaying }; delay(400) } }

    MaterialTheme(colorScheme = androidx.compose.material3.darkColorScheme(primary = Blue, onPrimary = Color.Black, background = Ink, surface = Panel, surfaceVariant = Panel2, onBackground = TextPrimary, onSurface = TextPrimary, onSurfaceVariant = Muted, outline = Line)) {
        Surface(Modifier.fillMaxSize(), color = Ink) {
            when (session) {
                "splash" -> SplashScreen { session = if (api.token != null) "home" else "welcome" }
                "welcome" -> WelcomeScreen({ session = "login" }, { session = "login" })
                "login" -> AuthScreen(api, { session = "home" }, { session = "welcome" })
                else -> Scaffold(
                    containerColor = Ink,
                    snackbarHost = { SnackbarHost(snackbar) },
                    topBar = { if (route == "main") MainTopBar(tab, { route = "notifications" }, { route = "profile" }) },
                    bottomBar = { if (route == "main") Column { if (current != null) MiniPlayer(current!!, playing, position, duration, { controller?.let { if (it.isPlaying) it.pause() else it.play() } }, { nextTrack(controller, queue, current, shuffle)?.let { startTrack(it, controller, queue) { current = it } } }) { route = "now" }; WaeveBottomBar(tab) { tab = it } } },
                    floatingActionButton = { if (route == "main" && tab == "library") androidx.compose.material3.FloatingActionButton({ showCreate = true }, containerColor = Blue, contentColor = Color.Black) { Icon(Icons.Default.Add, "Create playlist") } }
                ) { pad ->
                    Column(Modifier.fillMaxSize().padding(pad)) {
                        AnimatedContent(route, label = "waeve-route") { r ->
                            when (r) {
                                "now" -> NowPlaying(current, controller, position, duration, playing, shuffle, repeat, { controller?.seekTo(0) }, { controller?.let { if (it.isPlaying) it.pause() else it.play() } }, { nextTrack(controller, queue, current, shuffle)?.let { startTrack(it, controller, queue) { current = it } } }, { shuffle = !shuffle }, { repeat = (repeat + 1) % 3 }, { route = "queue" }, { current?.let { api.like(it.id) { r -> scope.launch { toast = r.fold({ "Added to liked songs" }, { it.message ?: "Like failed" }) } } } }) { route = "main" }
                                "queue" -> QueueScreen(queue, current) { startTrack(it, controller, queue) { current = it }; route = "now" }
                                "create" -> Unit
                                "charts" -> ChartsScreen()
                                "premium" -> PremiumScreen { toast = it }
                                "studio" -> ArtistStudioScreen(api) { toast = it }
                                "notifications" -> NotificationsScreen { route = "main" }
                                "profile" -> ProfileScreen({ route = it }) { api.clearSession(); session = "welcome"; route = "main" }
                                "settings" -> SettingsScreen { toast = it }
                                "stats" -> StatsScreen()
                                "downloads" -> DownloadsScreen()
                                else -> when (tab) {
                                    "home" -> HomeScreen(api, { enqueueAndPlay(it, controller, queue) { queue = it.first; current = it.second } }, { toast = it })
                                    "search" -> SearchScreen(api, { enqueueAndPlay(it, controller, queue) { queue = it.first; current = it.second } })
                                    "library" -> LibraryScreen(api, { toast = it })
                                    "discover" -> DiscoverScreen(api, { enqueueAndPlay(it, controller, queue) { queue = it.first; current = it.second } })
                                    "charts" -> ChartsScreen()
                                    else -> ProfileScreen({ route = it }) { api.clearSession(); session = "welcome" }
                                }
                            }
                        }
                    }
                }
            }
            if (showCreate) { CreatePlaylistDialog(api) { showCreate = false; if (it.isNotBlank()) toast = it } }
        }
    }
}

